<section class="section wrap">
  <span class="eyebrow">Search</span>
  <h1 class="section-title">{% if search.performed %}{{ search.results_count }} results for “{{ search.terms | escape }}”{% else %}Search the gallery{% endif %}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search works, artists, pages" aria-label="Search">
    <button type="submit" class="btn">Search</button>
  </form>
  {% if search.performed %}
    <div class="grid" style="margin-top:64px">
      {% for item in search.results %}
        {% if item.object_type == 'product' %}
          {% render 'product-card', product: item %}
        {% else %}
          <article class="card">
            <a href="{{ item.url }}"><h4>{{ item.title }}</h4></a>
            <p class="muted small">{{ item.content | strip_html | truncatewords: 30 }}</p>
          </article>
        {% endif %}
      {% else %}
        <p>No results found.</p>
      {% endfor %}
    </div>
  {% endif %}
</section>
{% schema %}{ "name": "Search", "settings": [] }{% endschema %}
