<section class="section {% if section.settings.tinted %}section--card{% endif %}">
  <div class="wrap">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {% if section.settings.heading != blank %}
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="image-gallery">
      {% for block in section.blocks %}
        <figure class="image-gallery__item" {{ block.shopify_attributes }}>
          <div class="imgwrap--45">
            {% if block.settings.image %}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.alt }}
            {% elsif block.settings.fallback != blank %}
              <img src="{{ block.settings.fallback | asset_url }}" alt="{{ block.settings.alt | escape }}" width="900" height="1125" loading="lazy">
            {% endif %}
          </div>
          <figcaption class="eyebrow eyebrow--muted">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</figcaption>
        </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Image gallery",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Selected works" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "tinted", "label": "Tinted background", "default": true }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback", "label": "Fallback asset filename" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    }
  ],
  "presets": [{ "name": "Image gallery" }]
}
{% endschema %}
