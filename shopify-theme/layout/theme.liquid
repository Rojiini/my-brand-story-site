<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{% if page_title %}{{ page_title }} — {% endif %}{{ shop.name }}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:title" content="{{ page_title | default: shop.name }}">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <style>
    :root{
      --royal-blue: {{ settings.color_royal }};
      --persian-gold: {{ settings.color_gold }};
      --ivory: {{ settings.color_ivory }};
      --void: {{ settings.color_void }};
    }
  </style>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  <a class="skip-link" href="#main">Skip to content</a>
  {% section 'header' %}
  <main id="main">{{ content_for_layout }}</main>
  {% section 'footer' %}
</body>
</html>
