<section class="section section--card">
  <div class="wrap">
    <div class="section-head">
      <div>
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h3 class="section-title">{{ section.settings.heading }}</h3>
      </div>
      {% if section.settings.link != blank %}
        <a class="eyebrow eyebrow--muted" href="{{ section.settings.link }}">{{ section.settings.link_label }} &rarr;</a>
      {% endif %}
    </div>
    <div class="programme">
      {% for block in section.blocks %}
        <article class="programme__item" {{ block.shopify_attributes }}>
          <div class="imgwrap imgwrap--45">
            {% if block.settings.image %}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {% elsif block.settings.fallback != blank %}
              <img src="{{ block.settings.fallback | asset_url }}" alt="{{ block.settings.title | escape }}" width="1200" height="1600" loading="lazy">
            {% endif %}
          </div>
          <div class="programme__meta">
            <span class="eyebrow">{{ block.settings.number }}</span>
            <span class="eyebrow eyebrow--muted">{{ block.settings.dates }}</span>
          </div>
          <h4>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.title }}</a>{% else %}{{ block.settings.title }}{% endif %}</h4>
          <p class="muted">{{ block.settings.artist }}</p>
          {% if block.settings.text != blank %}<p class="muted small">{{ block.settings.text }}</p>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Programme grid",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Events" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recent & Upcoming" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View All Events" }
  ],
  "blocks": [
    {
      "type": "exhibition",
      "name": "Exhibition",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "dates", "label": "Dates", "default": "Jun 12 — Sep 14" },
        { "type": "text", "id": "title", "label": "Title", "default": "Exhibition title" },
        { "type": "text", "id": "artist", "label": "Artist", "default": "Artist name" },
        { "type": "textarea", "id": "text", "label": "Description" },
        { "type": "url", "id": "link", "label": "Event link" },
        { "type": "text", "id": "fallback", "label": "Theme asset filename (used if no image is chosen)" }
      ]
    }
  ],
  "presets": [{ "name": "Programme grid" }]
}
{% endschema %}
