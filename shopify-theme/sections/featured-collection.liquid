<section class="section section--card">
  <div class="wrap">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="section-title">{{ section.settings.heading }}</h2>
    <div class="grid" style="margin-top:64px">
      {% assign col = collections[section.settings.collection] | default: collections.all %}
      {% for product in col.products limit: section.settings.limit %}
        {% render 'product-card', product: product %}
      {% else %}
        <p>No works available yet.</p>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Featured collection","settings":[
 {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Available Works"},
 {"type":"text","id":"heading","label":"Heading","default":"From the shop"},
 {"type":"collection","id":"collection","label":"Collection"},
 {"type":"range","id":"limit","label":"Products","min":3,"max":24,"step":3,"default":6}
],"presets":[{"name":"Featured collection"}]}
{% endschema %}
