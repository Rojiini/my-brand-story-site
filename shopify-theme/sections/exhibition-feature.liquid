<section class="section wrap feature">
  <div class="feature__media">
    {% if section.settings.image %}
      <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.title | escape }}" loading="lazy">
    {% else %}
      <img src="{{ 'exhibition-1.jpg' | asset_url }}" alt="{{ section.settings.title | escape }}" loading="lazy">
    {% endif %}
  </div>
  <div class="feature__text">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h3 class="feature__title">{{ section.settings.title }}</h3>
    <p class="feature__artist">by {{ section.settings.artist }}</p>
    <div class="hairline hairline--left"></div>
    <p class="feature__blurb">{{ section.settings.blurb }}</p>
    {% if section.settings.link != blank %}
      <a class="underline-link" href="{{ section.settings.link }}">{{ section.settings.link_label }} &rarr;</a>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Exhibition feature",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Current Exhibition · 01" },
    { "type": "text", "id": "title", "label": "Title", "default": "Kufic & Gold" },
    { "type": "text", "id": "artist", "label": "Artist", "default": "Betsabeh Shahlaei" },
    { "type": "textarea", "id": "blurb", "label": "Description", "default": "A square-kufic composition in black sits beside a vertical gilded panel, anchored by three turquoise lozenges. Geometry and shimmer hold each other in balance." },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All Exhibitions" }
  ],
  "presets": [{ "name": "Exhibition feature" }]
}
{% endschema %}
