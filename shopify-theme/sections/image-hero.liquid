<section class="hero">
  {% if section.settings.image %}
    {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt }}
  {% else %}
    <img src="{{ 'hero-gallery.jpg' | asset_url }}" alt="{{ shop.name | escape }}" width="1600" height="1200" fetchpriority="high">
  {% endif %}
  <div class="inner">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.tagline }}</p>
    <div class="hairline"></div>
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "HICH Gallery" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Where nothing becomes everything." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NOW ON VIEW" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
