<header class="site-header">
  <div class="wrap">
    <a href="{{ routes.root_url }}" class="logo" aria-label="{{ shop.name | escape }} home">
      {% render 'hich-logo' %}
    </a>
    <nav class="main-nav" aria-label="Main">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" {% if link.active %}class="active"{% endif %}>{{ link.title }}</a>
      {% endfor %}
    </nav>
    <div class="header-actions">
      <a href="{{ routes.search_url }}" class="eyebrow eyebrow--muted hide-mobile">Search</a>
      <a href="{{ routes.cart_url }}" class="cart-link" aria-label="Cart">
        {% render 'icon-cart' %}
        {% if cart.item_count > 0 %}<span class="cart-count">{{ cart.item_count }}</span>{% endif %}
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
  <nav class="mobile-nav" id="mobile-nav" hidden aria-label="Mobile">
    {% for link in section.settings.menu.links %}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {% endfor %}
    <a href="{{ routes.search_url }}">Search</a>
  </nav>
</header>
{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
