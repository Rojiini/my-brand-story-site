<section class="wrap product">
  <div class="product__media" data-product-gallery role="region" aria-roledescription="carousel" aria-label="{{ product.title | escape }} photos">
    {% if product.images.size > 0 %}
      <div class="product-gallery__track" data-gallery-track tabindex="0" aria-label="Product photos">
        {% for image in product.images %}
          {% assign photo_alt = image.alt | default: product.title %}
          <div class="artwork-frame product-gallery__slide" data-gallery-slide role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ product.images.size }}">
          {% if forloop.first %}
          {{ image | image_url: width: 2400 | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '400, 600, 800, 1000, 1200, 1600, 2000, 2400',
            sizes: '(min-width: 900px) calc((min(100vw, 1400px) - 112px) / 2), calc(100vw - 48px)',
            class: 'artwork-img',
            alt: photo_alt }}
          {% else %}
          {{ image | image_url: width: 2400 | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1000, 1200, 1600, 2000, 2400',
            sizes: '(min-width: 900px) calc((min(100vw, 1400px) - 112px) / 2), calc(100vw - 48px)',
            class: 'artwork-img',
            alt: photo_alt }}
          {% endif %}
          </div>
        {% endfor %}
      </div>
      {% if product.images.size > 1 %}
        <div class="product-gallery__controls">
          <button type="button" class="btn product-gallery__arrow" data-gallery-prev aria-label="Previous photo" title="Previous photo">&#8592;</button>
          <span data-gallery-count aria-live="polite" aria-atomic="true">1 / {{ product.images.size }}</span>
          <button type="button" class="btn product-gallery__arrow" data-gallery-next aria-label="Next photo" title="Next photo">&#8594;</button>
        </div>
        <div class="product-gallery__thumbs">
          {% for image in product.images %}
            <button type="button" class="btn product-gallery__thumb" data-gallery-index="{{ forloop.index0 }}" aria-label="View photo {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
              {{ image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100, 200', sizes: '80px', alt: '' }}
            </button>
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}
  </div>
  <div class="product__info">
    <span class="eyebrow">{{ product.vendor }}</span>
    <h1>{{ product.title }}</h1>
    <div class="price">{{ product.selected_or_first_available_variant.price | money }}</div>
    <div class="desc">{{ product.description }}</div>
    <form method="post" action="{{ routes.cart_add_url }}">
      {% unless product.has_only_default_variant %}
        {% for variant in product.variants %}
          <label style="display:block;margin-bottom:8px">
            <input type="radio" name="id" value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}checked{% endif %} {% unless variant.available %}disabled{% endunless %}>
            {{ variant.title }} — {{ variant.price | money }}
          </label>
        {% endfor %}
      {% else %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      {% endunless %}
      <button type="submit" class="btn btn--solid" {% unless product.available %}disabled{% endunless %}>
        {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
      </button>
    </form>
  </div>
</section>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Product","name":{{ product.title | json }},"description":{{ product.description | strip_html | json }},"brand":{"@type":"Brand","name":{{ product.vendor | json }}},"offers":{"@type":"Offer","priceCurrency":{{ shop.currency | json }},"price":"{{ product.price | money_without_currency }}","availability":"https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}"}}
</script>
{% schema %}{"name":"Product","settings":[]}{% endschema %}
