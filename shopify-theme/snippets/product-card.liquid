<article class="card">
  <a href="{{ product.url }}">
    <div class="imgwrap">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy">
      {% endif %}
    </div>
  </a>
  <a href="{{ product.url }}"><h4>{{ product.title }}</h4></a>
  <span class="price">{{ product.price | money }}</span>
  <form method="post" action="/cart/add">
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
    <button type="submit" class="btn" {% unless product.available %}disabled{% endunless %}>
      {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
    </button>
  </form>
</article>
