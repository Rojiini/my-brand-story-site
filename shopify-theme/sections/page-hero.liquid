<section class="page-hero wrap">
  <span class="eyebrow">{{ section.settings.eyebrow }}</span>
  <h1 class="page-hero__title">{{ section.settings.heading }}</h1>
  {% if section.settings.intro != blank %}
    <p class="page-hero__intro">{{ section.settings.intro }}</p>
  {% endif %}
</section>
{% schema %}
{
  "name": "Page hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Gallery" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "About & Visit" },
    { "type": "textarea", "id": "intro", "label": "Intro" }
  ],
  "presets": [{ "name": "Page hero" }]
}
{% endschema %}
